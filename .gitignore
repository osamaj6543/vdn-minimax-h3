# weights live on the Hub (src/paths.py downloads them); a local copy goes here
ckpts/
results/
logs/

# local-only helpers (weight staging, run wrappers); not part of the release
scripts/local/

__pycache__/
*.pyc
.claude/

# fetched by scripts/setup_diffusers.sh (upstream pin + diffusers_patches/)
diffusers/
*.egg-info/

# inference server runtime data (uploads, rendered mp4s, prompt caches)
server_data/
.pytest_cache/

# frontend build output and dependencies (source stays tracked)
frontend/node_modules/
frontend/.next/

# one-off local setup logs (not part of the project)
/frontend_create.log
/next_build.log
/next_build2.log
/next_start.log
/npm_appwrite.log
/shadcn_add.log
/shadcn_init.log