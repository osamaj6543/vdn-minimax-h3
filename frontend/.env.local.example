# --- Appwrite: server-side only ---------------------------------------------
# These are used by the Next.js server (auth BFF). They are NOT exposed to the
# browser: no NEXT_PUBLIC_ prefix, so they never reach the client bundle.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT=your-project-id
# Server API key. Create it in the Appwrite console (Overview -> Integrations ->
# API keys) with the sessions.write scope. Required: Appwrite only returns a
# session's `secret` to API-key-authenticated server calls, and that secret is
# what the httpOnly session cookie carries. It also lets the server mint the
# gateway JWTs and bypasses unauthenticated per-IP rate limits.
APPWRITE_API_KEY=your-server-api-key

# --- Session cookie sealing --------------------------------------------------
# 32+ chars, server-only. Encrypts the sealed session cookie (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-32-byte-random-string

# --- VDN gateway (server-side) ----------------------------------------------
# The browser never calls this host: it talks to /api/gateway on our own origin.
GATEWAY_URL=http://localhost:8000

# --- Optional ----------------------------------------------------------------
# Where the sign-in page points for account recovery / docs (unused today).
# NEXT_PUBLIC_DOCS_URL=https://github.com/OpenVDN/vdn-minimax-h3

